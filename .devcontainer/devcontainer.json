{
  "name": "NAF AI Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  // Install Python deps, Claude Code, and configure API key
  "postCreateCommand": "pip install --upgrade pip && pip install uv && uv sync; npm install -g @anthropic-ai/claude-code || true; API_KEY=\"${USAF_ANG_LAB:-${ANTHROPIC_API_KEY}}\"; if [ -n \"${API_KEY}\" ]; then echo \"ANTHROPIC_API_KEY=${API_KEY}\" > .env && echo '✅ Environment ready! Type: claude'; else cp .env.template .env && echo '⚠️  No API key found. Edit .env to add your ANTHROPIC_API_KEY'; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.useEnvFile": true,
        "python.envFile": "${workspaceFolder}/.env",
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true,
          ".pytest_cache": true,
          "*.egg-info": true
        }
      }
    }
  },
  "forwardPorts": [8000],
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "remoteUser": "vscode",
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "postAttachCommand": "echo 'source .venv/bin/activate && export $(grep ANTHROPIC_API_KEY /workspaces/naf-ai-agents-workshop/.env 2>/dev/null | xargs)' >> ~/.zshrc && source ~/.zshrc",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  }
}
